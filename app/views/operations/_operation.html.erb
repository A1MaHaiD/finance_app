<div id="<%= dom_id operation %>">
  <p>
    <strong>Сума:</strong>
    <%= operation.amount %>
  </p>

  <p>
    <strong>Тип транзакції:</strong>
    <%= operation.operation_type %>
  </p>

  <p>
    <strong>Дата:</strong>
    <%= operation.odate %>
  </p>

  <p>
    <strong>Опис:</strong>
    <%= operation.description %>
  </p>

  <p>
    <strong>Категорії:</strong>
    <%= operation.category.name %>
  </p>

</div>
