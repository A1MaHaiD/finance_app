<p style="color: green"><%= notice %></p>

<% content_for :title, "Operations" %>

<h1>Operations</h1>

<div id="operations">
  <% @operations.each do |operation| %>
    <%= render operation %>
    <p>
      <%= link_to "Show this operation", category_operation_path(@category, operation) %>
    </p>
  <% end %>
</div>

<%= link_to "New operation", new_category_operation_path(@category)  %>
