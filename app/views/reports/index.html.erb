<link rel="stylesheet" type="text/css" href="/app/assets/stylesheets/form.css">
<h1>Генератор звітів</h1>
<script>
    function submitForm(action) {
        var form = document.getElementById('backgroung');
        form.action = action;
        form.submit();
    }
</script>
<div class="container">
  <form id="backgroung" name="generate_report" method="GET">
    <div class="row g-3 align-items-center">
      <div class="col-auto">
        <label for="start_date" class="col-form-label">Дата DD-MM-YYYY</label>
      </div>
      <div class="col-auto">
        <input type="date" id="start_date" name="start_date" class="form-control">
      </div>
    </div>
    <div class="row g-3 align-items-center">
      <div class="col-auto">
        <label for="end_date" class="col-form-label">Дата DD-MM-YYYY</label>
      </div>
      <div class="col-auto">
        <input type="date" id="end_date" name="end_date" class="form-control">
      </div>
    </div>
    <div class="row g-3 align-items-center">
      <div class="col-auto">
        <label for="operation_type" class="col-form-label">Тип операції</label>
      </div>
      <div class="col-auto">
        <select id="operation_type" name="operation_type" class="form-control">
          <option value="Витрати">Витрат</option>
          <option value="Доходи">Доходів</option>
        </select>
      </div>
    </div>
    <div class="row g-3 align-items-center">
      <div class="col-auto">
        <label for="category" class="col-form-label">Категорії</label>
      </div>
      <div class="col-auto">
        <% unless @categories.nil? %>
          <%= select_tag :category, options_for_select(@categories.map { |name, id, _| [name, id] }, selected: params[:category]), class: "form-control" %>
      <% else %>
          <p>Немає доступних категорій</p>
        <% end %>
      </div>
    </div>
    <input id="button-form" type="submit" class="btn btn-success" value="Графік" onclick="submitForm('/reports/report_by_category')">
    <input id="button-form" type="submit" class="btn btn-danger" value="По датам" onclick="submitForm('/reports/report_by_dates')">
  </form>
</div>
