<h1>Розподіл витрат за період:</h1>
<div style="display: flex; justify-content: center;">
<canvas id="reportDatesChart" width="1800" height="800"></canvas>
<script>
    var context = document.getElementById('reportDatesChart').getContext('2d');
    var chart = new Chart(context, {
        type: 'line',
        data: {
            labels: <%= raw @odates %>,
            datasets: [{
                label: 'Кошти',
                backgroundColor: 'rgb(99,125,255)',
                borderColor: 'rgb(255, 99, 132)',
                data: <%= raw @amounts %>
            }]
        },
        options: {
            responsive: false,
            plugins: {
                legend: {
                    labels: {
                        font: {
                            size: 16,
                            bold:
                              true
                        }
                    }
                }
            }
        }
    });
</script>
</div>