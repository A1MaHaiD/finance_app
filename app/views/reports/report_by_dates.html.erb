<h1>Розподіл <%= params[:operation_type] == 'Витрати' ? 'витрат' : 'доходів' %> за період:
  <strong style="color: #8546bc "><%= Date.parse(params[:start_date]).strftime("%d-%m-%Y") %></strong> -
  <strong style="color: #8546bc"><%= Date.parse(params[:end_date]).strftime("%d-%m-%Y") %></strong></h1>
<div style="display: flex; justify-content: center;">
  <canvas id="reportDatesChart" width="1300px" height="700"></canvas>
  <script>
      var operationType = '<%= params[:operation_type] %>';
      var backgroundColor = operationType === 'Витрати' ? 'rgb(218,146,18)' : 'rgb(83,188,127)';
      var categoryName = '<%= Category.find(params[:category]).name %>';

      var context = document.getElementById('reportDatesChart').getContext('2d');
      var chart = new Chart(context, {
          type: 'bar',
          data: {
              labels: <%= raw @odates %>,
              datasets: [{
                  label: categoryName,
                  backgroundColor: backgroundColor,
                  borderColor: 'rgb(255, 99, 132)',
                  data: <%= raw @amounts %>
              }]
          },
          options: {
              responsive: false,
              plugins: {
                  legend: {
                      labels: {
                          font: {
                              size: 24,
                              bold:
                                  true
                          }
                      },
                      datasets: {
                          font: {
                              size: 16,
                              bold: true
                          }
                      }
                  }
              }
          }
      });
  </script>
</div>