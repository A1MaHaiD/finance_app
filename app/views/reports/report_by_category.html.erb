<h1 style="margin: 36px 0px" xmlns="http://www.w3.org/1999/html">Звіт <%= params[:operation_type] == 'Витрати' ? 'по витратах' : 'по доходах' %>
  в розрізі категорії:</h1>
<h4>Розподіл <%= params[:operation_type] == 'Витрати' ? 'витрат' : 'доходів' %> за період:
  <strong style="color: #8546bc"> <%= Date.parse(params[:start_date]).strftime("%d-%m-%Y") %></strong> -
  <strong style="color: #8546bc"> <%= Date.parse(params[:end_date]).strftime("%d-%m-%Y") %></h4> </strong>
<div style="display: flex; justify-content: center;">
  <canvas id="reportCategoryChart" width="1300px" height="700"></canvas>
</div>
<script>
    const context = document.getElementById('reportCategoryChart');
    const chart = new Chart(context, {
        type: 'doughnut',
        data: {
            labels: <%= raw @names.to_json %>,
            datasets: [{
                label: 'Гривень',
                data: <%= raw @sums.to_json %>,
                backgroundColor: [
                    'rgb(255, 99, 132)',
                    'rgb(75, 192, 192)',
                    'rgb(255, 205, 86)',
                    'rgb(119,174,135)',
                    'rgb(155,170,84)',
                    'rgb(188,88,171)',
                    'rgb(207,112,93)',
                    'rgb(82,172,150)',
                    'rgb(140,58,97)',
                    'rgb(33,95,158)',
                    'rgb(129,108,20)',
                    'rgb(84,60,126)',
                    'rgb(230,85,42)',
                    'rgb(54, 162, 235)'
                ]
            }]
        },
        options: {
            responsive: false,
            cutout: 0,
            plugins: {
                legend: {
                    labels: {
                        font: {
                            size: 16,
                            bold:
                                true
                        }
                    }
                }
            }
        }
    });
</script>
</div>
</div>