<link rel="stylesheet" type="text/css" href="/app/assets/stylesheets/devise.css">
<div class="container">
  <div class="card">
    <h2>Відновлення паролю</h2>

    <% if resource.errors.any? %>
      <div class="error-message">
        <span class="error-icon">&#9888;</span>
        <div class="error-text">Введіть вашу електронну пошту</div>
      </div>
    <% end %>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="field">
        <%= f.label :email, "Електронна пошта" %><br/>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "Введіть пошту" %>
      </div>

      <div class="actions">
        <%= f.submit "Відправити запит скидання пароля", class:"btn btn-secondary button-reset-pass" %>
      </div>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</div>