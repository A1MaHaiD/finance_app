<link rel="stylesheet" type="text/css" href="/app/assets/stylesheets/form.css">
<%= form_with(model: category) do |form| %>
  <% if category.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(category.errors.count, "error") %> prohibited this category from being saved:</h2>

      <ul>
        <% category.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div id="name">
    <label class="form-label">Назва категорії
    </label>
    <%= form.text_field :name %>
  </div>

  <div id="description">
    <label class="form-label">Короткий опис
    </label>
    <%= form.text_field :description %>
  </div>

  <div id="create">
    <span><%= form.submit class: "btn btn-success", value: "Зберегти", id: "button-form" %></span>
    <span><%= link_to "Назад", categories_path, class: "btn btn-primary", id: "button-form"%></span>
  </div>
<% end %>
