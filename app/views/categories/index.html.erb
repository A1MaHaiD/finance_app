<style type="text/css">
    #notice {
        color: green;
    }

    .container-main {
        margin-top: 50px;
        display: flex;
        flex-direction: column; /* Add this to stack children vertically */
        align-items: center;
        position: relative;
    }

    .table {
        background-color: #e9efed;
        border-radius: 15px;
        width: 1000px;
    }

    #add_category {
        margin-top: 20px; /* Add some margin for spacing */
    }

    .pagination {
        margin-top: 10px; /* Add some margin for spacing */
    }

    .interaction {
        display: flex;
        justify-content: center;
        gap: 10px;
    }

    .btn-link {
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        height: 24px;
        width: 24px;
    }

    .bi-pencil-square, .bi-x-square {
        font-size: 24px;
    }

    .bi-pencil-square {
        color: orange;
    }

    .bi-x-square {
        color: red;
    }
</style>
<p id="notice"><%= notice %></p>

<% content_for :title, "Categories" %>

<h1>Категорії витрат / доходів</h1>
<div class="container-main">
  <div id="categories">
    <table class="table">
      <thead>
      <tr>
        <th>#</th>
        <th><strong>Назва</strong></th>
        <th><strong>Опис</strong></th>
        <th><strong>Управління</strong></th>
      </tr>
      </thead>
      <tbody>
      <% @categories.each_with_index do |category, index| %>
        <tr id="<%= dom_id(category) %>">
          <td><%= index + 1 %></td>
          <td><%= category.name %></td>
          <td><%= category.description %></td>
          <td>
            <div class="interaction">
              <%= link_to edit_category_path(category), class: "btn btn-link", data: { test: "edit-category" } do %>
                <i class="bi bi-pencil-square"></i>
              <% end %>
              <%= button_to category_path(category), method: :delete, class: "btn btn-link",
                            data: { test: "destroy-category", confirm: "Are you sure?" } do %>
                <i class="bi bi-x-square"></i>
              <% end %>
            </div>
          </td>
        </tr>
      <% end %>
      </tbody>
    </table>
  </div>
  <div>
    <span id="add_category">
      <%= link_to "Додати нову категорію", new_category_path, class: "btn btn-primary",
                  data: { test: "new-category" } %>
    </span>
    <span class="pagination">
      <%= paginate @categories %>
    </span>
  </div>

</div>
